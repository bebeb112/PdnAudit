<Window x:Class="PdnAudit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PdnAudit"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel Orientation="Vertical">
        <TextBlock x:Name="PrivacyDocumentTextBlock" Text="Политика" FontSize="30" Padding="10"></TextBlock>
        <TextBlock x:Name="ConsentDocumentTextBlock" Text="Согласие" FontSize="30" Padding="10"></TextBlock>
        <TextBlock x:Name="DocumentLinksAmountTextBlock" Text="Количество" FontSize="30" Padding="10"></TextBlock>
        <TextBlock x:Name="FormsAmountTextBlock" Text="Количество форм на странице: " FontSize="30"></TextBlock>
        <TextBlock x:Name="ResultsTextBlock" Text="Замечания" FontSize="30"></TextBlock>
    </StackPanel>
</Window>
